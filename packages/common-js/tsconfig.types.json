{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "module": "NodeNext",
    "moduleDetection": "force",
    "moduleResolution": "NodeNext",
    "noCheck": true,
    "outDir": "types",
    "rootDir": ".",
    "skipLibCheck": true,
    "stripInternal": true,
    "target": "ES2022"
  },
  "include": [
    "**/*.js"
  ],
  "exclude": [
    "gulpfile.js",
    "node_modules/**",
    "test/**",
    "types/**"
  ]
}
