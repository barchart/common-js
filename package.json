{
  "name": "@barchart/common-js-monorepo",
  "private": true,
  "type": "module",
  "description": "Public JavaScript packages containing shared utilities for browser, market data, and Node.js applications",
  "author": {
    "name": "Bryan Ingle",
    "email": "bryan.ingle@barchart.com",
    "url": "https://www.barchart.com"
  },
  "contributors": [
    {
      "name": "Luka Sotra",
      "email": "luka.sotra@barchart.com",
      "url": "https://www.barchart.com"
    }
  ],
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "clean": "lerna clean --yes && rm -rf node_modules",
    "lint": "eslint eslint.config.js packages",
    "test": "lerna run test --stream",
    "publish": "lerna run publish:npm --stream --concurrency 1",
    "preversion": "git diff --exit-code",
    "release": "lerna version -m 'Release. Bump version number %v' --tag-version-prefix='' --force-publish --sign-git-tag --sign-git-commit"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.1",
    "globals": "^14.0.0",
    "lerna": "^9.0.7"
  }
}
